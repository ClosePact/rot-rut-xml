{
    "name": "closepact/rot-rut-xml",
    "description": "Create and validate Swedish ROT/RUT payment-request XML files (Skatteverket, Rot och rut – företag). Local, offline, version-aware.",
    "type": "library",
    "license": "MIT",
    "keywords": ["rot", "rut", "skatteverket", "sweden", "xml", "xsd", "validation", "tax-deduction", "invoicing", "begaran"],
    "homepage": "https://github.com/ClosePact/rot-rut-xml",
    "support": {
        "issues": "https://github.com/ClosePact/rot-rut-xml/issues",
        "source": "https://github.com/ClosePact/rot-rut-xml",
        "docs": "https://github.com/ClosePact/rot-rut-xml/tree/main/docs"
    },
    "authors": [
        {
            "name": "Closepact",
            "homepage": "https://closepact.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "ext-openssl": "Needed by `rot-rut schemas:fetch` to download Skatteverket's XSD files over HTTPS."
    },
    "autoload": {
        "psr-4": {
            "Closepact\\RotRutXml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Closepact\\RotRutXml\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/rot-rut"],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "format:check": "pint --test",
        "schemas": "@php bin/rot-rut schemas:fetch --include-samples",
        "check": ["@format:check", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
